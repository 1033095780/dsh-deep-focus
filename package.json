{
  "name": "dsh-deep-focus",
  "version": "1.0.0",
  "description": "A DSH bundle plugin: lock the UI to one conversation until it fully finishes, then release it with an optional DingTalk completion notification.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1033095780/dsh-deep-focus.git"
  },
  "homepage": "https://github.com/1033095780/dsh-deep-focus#readme",
  "bugs": {
    "url": "https://github.com/1033095780/dsh-deep-focus/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./icon": "./src/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2 || ^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "conversation-lock",
    "dingtalk",
    "task-completion"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js",
    "test": "node --test"
  }
}
